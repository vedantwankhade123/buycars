# Firebase web config. These are public configuration identifiers, not secrets.
# Access control is enforced by Firebase Auth + Firestore Security Rules.
# Copy to .env.local (git-ignored) and fill in from Firebase console > Project settings > Your apps.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Cloudinary
VITE_CLOUDINARY_CLOUD_NAME=

# Server-side only. Never prefix a private secret with VITE_.
# Configure these in Netlify > Site settings > Environment variables.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_UPLOAD_PRESET=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# FIREBASE_SERVICE_ACCOUNT=

# Local dev alternative to FIREBASE_SERVICE_ACCOUNT JSON:
# FIREBASE_SERVICE_ACCOUNT_FILE=C:/private/firebase-service-account.json
